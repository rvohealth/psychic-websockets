{
  "type": "module",
  "name": "@rvoh/psychic-websockets",
  "description": "Websocket system for Psychic applications",
  "version": "3.5.1",
  "author": "RVO Health",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvohealth/psychic-websockets.git"
  },
  "license": "MIT",
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    },
    "./testing": {
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/esm/src/testing/index.js",
      "require": "./dist/cjs/src/testing/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "client": "pnpm --cwd=./client start",
    "client:fspec": "cd client && BROWSER=none VITE_PSYCHIC_ENV=test pnpm start",
    "psy": "NODE_ENV=${NODE_ENV:-test} pnpm psy:ts",
    "psy:js": "node ./dist/test-app/src/cli/index.js",
    "psy:ts": "tsx ./test-app/src/cli/index.ts",
    "build": "echo \"building cjs...\" && rm -rf dist && tsc -p ./tsconfig.cjs.build.json && echo \"building esm...\" && tsc -p ./tsconfig.esm.build.json",
    "build:test-app": "rm -rf dist && echo \"building test app to esm...\" && tsc -p ./tsconfig.esm.build.test-app.json && echo \"building test app to cjs...\" && tsc -p ./tsconfig.cjs.build.test-app.json",
    "uspec": "vitest --config ./spec/unit/vite.config.ts",
    "fspec": "vitest run --config=./spec/features/vite.config.ts",
    "fspec:hanging": "vitest run --config=./spec/features/vite.config.ts --reporter=hanging-process",
    "format": "pnpm prettier . --write",
    "lint": "pnpm eslint --no-warn-ignored \"src/**/*.ts\" && pnpm prettier . --check",
    "dev": "NODE_ENV=development tsx ./test-app/main.ts",
    "ws": "NODE_ENV=development tsx ./test-app/ws.ts",
    "ws:fspec": "NODE_ENV=test tsx ./test-app/ws.ts",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@rvoh/dream": ">=2.0.0",
    "@rvoh/psychic": ">=2.3.8",
    "@socket.io/redis-adapter": "*",
    "@socket.io/redis-emitter": "*",
    "ioredis": "*",
    "socket.io": "*",
    "socket.io-adapter": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@koa/cors": "^5.0.0",
    "@koa/etag": "^5.0.2",
    "@koa/router": "^15.7.0",
    "@rvoh/dream": "^2.33.0",
    "@rvoh/dream-spec-helpers": "^2.3.0",
    "@rvoh/psychic": "^3.15.2",
    "@rvoh/psychic-spec-helpers": "^3.4.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-conditional-get": "^2.0.4",
    "@types/koa-etag": "^3.0.4",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "ioredis": "^6.0.0",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-conditional-get": "^3.0.0",
    "kysely": "^0.29.6",
    "kysely-codegen": "~0.20.0",
    "luxon-jest-matchers": "^0.1.14",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "puppeteer": "^25.12.0",
    "socket.io": "^4.8.4",
    "socket.io-adapter": "^2.5.8",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^18.0.4",
    "pluralize-esm": "^9.0.5",
    "yoctocolors": "^2.2.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
